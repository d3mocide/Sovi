# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=sovi
DB_USER=sovi
DB_PASSWORD=changeme

# Redis
REDIS_URL=redis://redis:6379/0

# API
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
DEBUG=false
LOG_LEVEL=info
CORS_ORIGINS=http://localhost


# Sign-ups: the first account is always allowed; later ones only if this is true
ALLOW_REGISTRATION=false

# Set to false ONLY for plain-HTTP development; keep true behind HTTPS
COOKIE_SECURE=true

# --- Only for docker-compose.release.yml (pre-built images) ---
# The release to run, without the leading v (see the Releases page): SOVI_VERSION=0.1.0
# SOVI_BIND is the address the web port listens on (default 127.0.0.1: put a reverse proxy in front);
# SOVI_PORT is the port (default 8080).
# SOVI_VERSION=
# SOVI_BIND=127.0.0.1
# SOVI_PORT=8080
